{
  "name": "vk-feed-bot",
  "version": "2.1",
  "description": "Pluggable VK feed bot: forwards new RSS/Atom entries from any number of configurable sources",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test \"src/test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.2",
    "he": "^1.2.0",
    "rss-parser": "^3.13.0",
    "vk-io": "^4.10.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/he": "^1.2.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
