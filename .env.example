# Секреты и глобальные дефолты. Настройки конкретных источников —
# в config/sources.yml (не секрет, версионируется в Git).

VK_TOKEN=YOUR_VK_TOKEN

TARGET_CHAT=2000000001
ADMIN_CHAT=2000000003
OWNER_ID=281457599

# Дефолты, если источник в sources.yml не задал свои pollIntervalMs/requestTimeoutMs
DEFAULT_POLL_INTERVAL_MS=60000
DEFAULT_REQUEST_TIMEOUT_MS=30000
USER_AGENT=VK-Feed-Bot/2.0

LOG_LEVEL=info

# OpenRouter (нужен, если хотя бы один источник использует enrich: openrouter)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_MODEL_NAME=GLM 5.2
OPENROUTER_PROMPT_FILE=templates/ai_comment.txt
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_TOKENS=300

# Таймаут загрузки изображения перед отправкой в VK
IMAGE_DOWNLOAD_TIMEOUT_MS=60000
# Таймаут самой загрузки файла на сервер VK
VK_UPLOAD_TIMEOUT_MS=90000

DATABASE_PATH=data/bot.db
SOURCES_FILE=config/sources.yml
