# Секреты и глобальные настройки. Всё, что касается конкретных источников —
# в config/sources.yml (не секрет, версионируется в Git).
#
# Здесь нет значений по умолчанию для id чатов и владельца: у каждого
# развёртывания свои, и молчаливый default означал бы отправку сообщений
# не туда. Все поля ниже обязательны, кроме помеченных «по умолчанию».

VK_TOKEN=YOUR_VK_TOKEN

# Куда постить сообщения бота
TARGET_CHAT=2000000001
# Куда слать отчёты об ошибках: id чата или id пользователя
ADMIN_CHAT=2000000003
# id пользователя, которому доступны административные команды
OWNER_ID=281457599

USER_AGENT=VK-Feed-Bot/2.0

# Потолок одновременных загрузок страниц постов ОДНОГО источника.
# Действует только на источники с site: lor или site: pingvinus: без потолка
# сборка тридцати новых постов шла строго последовательно, и время опроса
# росло вместе с их количеством. По умолчанию 5.
MAX_PARALLEL_PAGE_REQUESTS=5

# Сколько разобранных страниц постов держит стратегия сайта в памяти.
# Посты не меняются после публикации, поэтому разбирать страницу второй раз
# незачем. По умолчанию 500.
PAGE_CACHE_SIZE=500

LOG_LEVEL=info

# Таймаут загрузки картинки перед отправкой в VK
IMAGE_DOWNLOAD_TIMEOUT_MS=60000
# Таймаут самой загрузки файла на сервер VK
VK_UPLOAD_TIMEOUT_MS=90000

# OpenRouter — нужен, если хотя бы один источник использует enrich: openrouter.
# Без ключа бот не запустится, если такой источник есть в config/sources.yml.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_MODEL_NAME=GLM 5.2
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_TOKENS=700
# Повторы при временном сбое: 1 — без повторов. Сколько попыток на один запрос.
OPENROUTER_MAX_ATTEMPTS=3
# Задержка перед повтором, если OpenRouter не прислал Retry-After.
OPENROUTER_RETRY_DELAY_MS=2000

DATABASE_PATH=data/bot.db
SOURCES_FILE=config/sources.yml