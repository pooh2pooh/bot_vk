{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Дополнительная строгость поверх strict. Каждый флаг ниже уже поймал
    // реальный баг или мёртвый код при включении:
    //   noUnusedLocals/Parameters — мёртвый getEntry() и «пустые» проверки
    //   noUncheckedIndexedAccess  — выходы за границы массивов и .pop()
    //   noImplicitReturns        — забытый return в ветке switch/try
    //   noFallthroughCasesInSwitch — молчаливый fallthrough в обработчиках команд
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,

    // Source maps: стектрейсы из pm2 указывают на исходники, а не на dist.
    "sourceMap": true,
    "inlineSources": true,

    "outDir": "dist",
    "rootDir": "src",

    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/test"
  ]
}
